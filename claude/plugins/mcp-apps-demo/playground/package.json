{
  "name": "formbay-mcp-apps-playground",
  "private": true,
  "type": "module",
  "description": "A Claude-like chat page for trying the Formbay MCP App locally (based on the ext-apps basic-host example).",
  "scripts": {
    "build": "tsc --noEmit && cross-env INPUT=index.html vite build && cross-env INPUT=sandbox.html vite build",
    "start": "npm run build && tsx serve.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
